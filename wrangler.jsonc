// Cloudflare Worker `cre8-web`：靜態頁＋_worker.js 依網域分流（cre8.finance → index.html、tst.cre8.finance → app.html）。
// 部署：npx wrangler deploy（在這個資料夾）。
{
  "name": "cre8-web",
  "main": "_worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  // 2026-11-22 從 cre8-app-migration-preview 移過來（使用者：新 UI 取代 landing 與 tst）。
  "routes": [
    { "pattern": "cre8.finance", "custom_domain": true },
    { "pattern": "tst.cre8.finance", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
